ca_core_progress_bar = {
    name = "great_game_core_progress_bar_name"
    desc = "great_game_core_progress_bar_britain_desc"
    second_desc = "great_game_core_progress_bar_russia_desc"
    
    start_value = 100
    min_value = 0
    max_value = 200
    
    default_bad = yes

    monthly_progress = {
        add = {
            desc = "Decrease if intelligentsia is powerful"
            if = {
                limit = {
                    ig:ig_intelligentsia = {
                        is_powerful = yes
                    }
                }
                value = -10
            }
        }
        add = {
            desc = "Increase if intelligentsia is in government"
            if = {
                limit = {
                    ig:ig_intelligentsia = {
                        is_in_government = yes
                    }
                }
                value = 1
            }
        }
        add = {
            desc = "Decrease if intelligentsia is marginal"
            if = {
                limit = {
                    ig:ig_intelligentsia = {
                        is_marginal = yes
                    }
                }
                value = -10
            }
        }
        add = {
            desc = "Decrease if any of the specified laws are in place"
            if = {
                limit = {
                    OR = {
                        has_law_or_variant = law_type:law_total_separation
                        has_law_or_variant = law_type:law_cultural_exclusion
                        has_law_or_variant = law_type:law_census_voting
                        has_law_or_variant = law_type:law_universal_suffrage
                        has_law_or_variant = law_type:law_peasant_proprietorship
                        has_law_or_variant = law_type:law_right_of_assembly
                        has_law_or_variant = law_type:law_elected_bureaucrats
                    }
                }
                value = -5
            }
        }
        add = {
            desc = "Increase if any of the specified laws are in place"
            if = {
                limit = {
                    OR = {
                        has_law_or_variant = law_type:law_autocracy
                        has_law_or_variant = law_type:law_oligarchy
                        has_law_or_variant = law_type:law_single_party_state
                        has_law_or_variant = law_type:law_state_religion
                        has_law_or_variant = law_type:law_national_supremacy
                        has_law_or_variant = law_type:law_traditionalism
                        has_law_or_variant = law_type:law_hereditary_bureaucrats
                        has_law_or_variant = law_type:law_tenant_farmers
                        has_law_or_variant = law_type:law_censorship
                    }
                }
                value = 10
            }
        }
        add = {
            desc = "Increase if landowners are powerful"
            if = {
                limit = {
                    ig:ig_landowners = {
                        is_powerful = yes
                    }
                }
                value = 10
            }
        }
        add = {
            desc = "Increase if landowners are in government"
            if = {
                limit = {
                    ig:ig_landowners = {
                        is_in_government = yes
                    }
                }
                value = 10
            }
        }
        add = {
            desc = "Decrease if landowners are marginal"
            if = {
                limit = {
                    ig:ig_landowners = {
                        is_marginal = yes
                    }
                }
                value = -10
            }
        }
        add = {
            desc = "Decrease if fewer than 5 specified states are present"
            if = {
                limit = {
                    any_scope_state = {
                        OR = {
                            state_region = s:STATE_GUATEMALA
                            state_region = s:STATE_HONDURAS
                            state_region = s:STATE_COSTA_RICA
                            state_region = s:STATE_SAN_SALVADOR
                            state_region = s:STATE_NICARAGUA
                        }
                        count < 5
                    }
                }
                value = -15
            }
        }
        add = {
            desc = "Decrease if fewer than 4 specified states are present"
            if = {
                limit = {
                    any_scope_state = {
                        OR = {
                            state_region = s:STATE_GUATEMALA
                            state_region = s:STATE_HONDURAS
                            state_region = s:STATE_COSTA_RICA
                            state_region = s:STATE_SAN_SALVADOR
                            state_region = s:STATE_NICARAGUA
                        }
                        count < 4
                    }
                }
                value = -10
            }
        }
        add = {
            desc = "Decrease if fewer than 3 specified states are present"
            if = {
                limit = {
                    any_scope_state = {
                        OR = {
                            state_region = s:STATE_GUATEMALA
                            state_region = s:STATE_HONDURAS
                            state_region = s:STATE_COSTA_RICA
                            state_region = s:STATE_SAN_SALVADOR
                            state_region = s:STATE_NICARAGUA
                        }
                        count < 3
                    }
                }
                value = -5
            }
        }
        add = {
            desc = "Increase if fewer than 3 specified states are present"
            if = {
                limit = {
                    any_scope_state = {
                        OR = {
                            state_region = s:STATE_GUATEMALA
                            state_region = s:STATE_HONDURAS
                            state_region = s:STATE_COSTA_RICA
                            state_region = s:STATE_SAN_SALVADOR
                            state_region = s:STATE_NICARAGUA
                        }
                        count < 3
                    }
                }
                value = 20
            }
        }
        add = {
            desc = "Increase if fewer than 2 specified states are present"
            if = {
                limit = {
                    any_scope_state = {
                        OR = {
                            state_region = s:STATE_GUATEMALA
                            state_region = s:STATE_HONDURAS
                            state_region = s:STATE_COSTA_RICA
                            state_region = s:STATE_SAN_SALVADOR
                            state_region = s:STATE_NICARAGUA
                        }
                        count < 2
                    }
                }
                value = 25
            }
        }
        add = {
            desc = "Increase if fewer than 1 specified state is present"
            if = {
                limit = {
                    any_scope_state = {
                        OR = {
                            state_region = s:STATE_GUATEMALA
                            state_region = s:STATE_HONDURAS
                            state_region = s:STATE_COSTA_RICA
                            state_region = s:STATE_SAN_SALVADOR
                            state_region = s:STATE_NICARAGUA
                        }
                        count < 1
                    }
                }
                value = 30
            }
        }
    }
}