	exists = scope:character  
	scope:character = {  
		exists = home_country  
		home_country = {  
			is_subject = no  
			country_has_primary_culture = cu:spanish  
		}  
		OR = {  
			character_has_carlist_ideology = yes  
			home_country = {  
				c:SPC ?= this  
			}  
		}  
	}  
}
**Supported Scopes**: none  
**Supported Targets**: country  

## ordered_country_in_himalayas_old
french_empire_clothes_pop_trigger = {  
	exists = scope:pop  
	scope:pop = {  
		exists = c:FRA  
		home_country = {  
			OR = {  
				AND = {  
					c:FRA = this  
					is_subject = no # preventing uniform conflicts if FRA becomes a subject of another country with puppet uniforms  
				}  
				is_subject_of = c:FRA  
			}  
		}  
	}  
}
**Supported Scopes**: none  
**Supported Targets**: country  

