## ordered_province_in_afghanistan
russian_empire_clothes_pop_trigger = {  
	exists = scope:pop  
	scope:pop = {  
		exists = c:RUS  
		home_country = {  
			OR = {  
				AND = {  
					c:RUS = this  
					is_subject = no # preventing uniform conflicts if RUS becomes a subject of another country with puppet uniforms  
				}  
				is_subject_of = c:RUS  
			}  
		}  
	}  
}
**Supported Scopes**: none  
**Supported Targets**: province  

## ordered_province_in_africa
carlist_clothes_trigger = {  
	exists = scope:character  
	scope:character = {  
		exists = home_country  
		home_country = {  
			is_subject = no  
			country_has_primary_culture = cu:spanish  
		}  
		OR = {  
			character_has_carlist_ideology = yes  
			home_country = {  
				c:SPC ?= this  
			}  
		}  
	}  
}
**Supported Scopes**: none  
**Supported Targets**: province  

