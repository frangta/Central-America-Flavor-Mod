				### Texto del evento (derecha), igual que vanilla pero sin las opciones
				flowcontainer = {
					minimumsize = { -1 500 }
					direction = vertical
					spacing = 16
					parentanchor = right|vcenter
					margin = { 25 30 }

					background = {
						using = entry_bg_simple_solid
						margin = { -15 -20 }
					}

					background = {
						using = fade_center_colored_black
					}

					textbox = {
						name = "description"
						multiline = yes
						autoresize = yes
						minimumsize = { 440 -1 }
						maximumsize = { 460 -1 }
						parentanchor = top|hcenter
						align = nobaseline
						margin = { 10 0 }
						using = fontsize_large
						raw_text = "#bold [EventWindow.GetDescription]#!"
					}

					divider_decorative = {}

					textbox = {
						name = "flavortext"
						multiline = yes
						autoresize = yes
						minimumsize = { 440 -1 }
						maximumsize = { 460 -1 }
						parentanchor = top|hcenter
						align = top|left
						margin = { 10 10 }
						raw_text = "[EventWindow.GetFlavor]"
					}

					button = {
						visible = "[InDebugMode]"
						parentanchor = hcenter
						size = { 440 40 }
						using = default_button
						raw_text = "DEBUG: Open Event in text editor"
						onclick = "[EventWindow.AccessEvent.OpenInEditor]"
					}

					textbox = {
						visible = [InDebugMode]
						parentanchor = hcenter
						align = hcenter
						raw_text = "Event ID: [Event.GetKey|v]"
					}
				}
			}

