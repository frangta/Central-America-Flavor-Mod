types ca_event_window_119_types {

	### Fila de datos del recuadro de la UCA (icono + texto)
	type ca_ew119_data_row = widget {
		size = { 540 30 }

		icon = {
			position = { 0 1 }
			size = { 28 28 }
			block "row_icon" {
				texture = "gfx/interface/icons/event_icons/waving_flag.dds"
			}
		}

		block "row_content" {}
	}

	### Tarjeta de un bando
	type ca_ew119_card = widget {
		size = { 350 250 }

		background = {
			using = entry_bg_simple
		}

		icon = {
			position = { 0 0 }
			size = { 350 8 }
			block "card_band" {
				texture = "gfx/interface/ca_event_119/ca_ew119_band_federal.dds"
			}
		}

		icon = {
			position = { 135 14 }
			size = { 80 80 }
			block "card_icon" {
				texture = "gfx/interface/ca_event_119/ca_ew119_faction_federal.dds"
			}
		}

		textbox = {
			position = { 0 96 }
			size = { 350 26 }
			align = hcenter|nobaseline
			using = fontsize_large
			block "card_title" {
				text = "CA_EW119_FED_TITLE"
			}
		}

		textbox = {
			position = { 30 124 }
			size = { 150 22 }
			align = right|nobaseline
			using = fontsize_small
			text = "CA_EW119_DIFFICULTY"
		}

		block "card_difficulty" {}

		textbox = {
			position = { 15 150 }
			size = { 320 96 }
			multiline = yes
			align = top|left
			using = fontsize_small
			block "card_desc" {
				text = "CA_EW119_FED_DESC"
			}
		}

		block "card_tooltip" {
			tooltip = "CA_EW119_FED_TT"
		}
	}

	### Ventana del evento .119 (basada en event_window de vanilla 1.15)
	type ca_ew119_window = default_popup_two_lines {
		datacontext = "[EventWindow.GetEvent]"

		alpha = 0

		blockoverride "minimize" {
			minimize_button_large = {
				onclick = "[PopupManager.HideOpenEvent(Event.Self)]"
				parentanchor = center
				shortcut = "close_window"
			}
		}

		blockoverride "header_close_button_visibility" {
			visible = yes
		}

		blockoverride "window_header_name" {
			raw_text = "#BOLD [EventWindow.GetTitle]#!"
		}

		blockoverride "content" {}

		blockoverride "second_text" {
			text = "EVENT_WINDOW_EVENT_LOCATION"
		}

		blockoverride "goto_visibility" {
			visible = yes
		}

		blockoverride "goto_properties" {
			onclick = "[EventWindow.AccessEvent.AccessState.ZoomToCapital]"
			tooltip = "ZOOM_TO_EVENT_WINDOW_STATE"
			enabled = "[Not( EventWindow.AccessEvent.AccessState.IsZoomingToCapital )]"
		}

		state = {
			trigger_on_create = yes
			name = 1
			duration = 0.3
			using = Animation_Curve_EaseOut
			alpha = 1
			using = Snapshot_Mute_World_100
			using = Snapshot_Mute_Vfx_War_100
			start_sound = {
				soundeffect = "[Event.GetOnOpenedSoundEvent]"
			}
		}

		flowcontainer = {
			resizeparent = yes
			direction = vertical
			margin = { 35 0 }
			margin_bottom = 20
			spacing = 8

			### ARRIBA: RECUADRO DE LA UCA (izquierda) + TEXTO DEL EVENTO (derecha)
			container = {
				minimumsize = { 1120 -1 }
				position = { 0 10 }

				icon = {
					texture = "gfx/interface/event_window/event_inner_frame.dds"
					size = { 100% 100% }
					spriteType = Corneredtiled
					spriteborder = { 25 25 }
					spriteborder_right = 610
					spriteborder_top = 600
					texture_density = 2

					modify_texture = {
						texture = "gfx/interface/backgrounds/default_bg_shading.dds"
						spriteType = Corneredstretched
						spriteborder = { 0 0 }
						blend_mode = overlay
					}

					modify_texture = {
						using = texture_velvet
					}
				}

				widget = {
					position = { 3 3 }
					size = { 100% 100% }

					# El video del evento, apagado, de fondo
					video_icon = {
						visible = "[Event.HasVideo]"
						video = "[Event.GetVideo]"
						size = { 100% 100% }
						alwaystransparent = yes
						loop = no
						alpha = 0.3

						modify_texture = {
							texture = "gfx/interface/masks/fade_horizontal_right.dds"
							spriteType = Corneredstretched
							spriteborder = { 45 45 }
							spriteborder_bottom = 0
							blend_mode = alphamultiply
							texture_density = 2
						}

						modify_texture = {
							using = texture_velvet
						}
					}

					### Recuadro: el estado de la Union en 1836
					widget = {
						name = "ca_ew119_uca_box"
						position = { 20 14 }
						size = { 580 476 }

						background = {
							using = entry_bg_simple
						}

						textbox = {
							position = { 0 6 }
							size = { 580 26 }
							align = hcenter|nobaseline
							using = fontsize_large
							text = "CA_EW119_BOX_TITLE"
						}

							widget = {
								name = "ca_ew119_minimap"
								position = { 110 36 }
								size = { 360 287 }

								icon = {
									position = { 0 0 }
									size = { 360 287 }
									texture = "gfx/interface/ca_minimap/ca_minimap_base.dds"
								}
