# ============================================================================
# CAFM Z5 - Mapa de la Pacificacion del Norte (diario je_ca_pacificacion_norte)
# Mapa de la frontera con costas, lago y frontera reales (Natural Earth), estilo antiguo, zona coloreada segun ca_pacificacion_progress,
# marcadores de los hechos de 1836 y lista de etapas a la derecha.
# ============================================================================

types ca_pacificacion_types {
	type ca_pacificacion_map_type = widget {
		name = "ca_pacificacion_map_widget"
		size = { 530 470 }

		background = {
			using = entry_bg_simple
		}

		textbox = {
			position = { 10 6 }
			size = { 510 26 }
			align = left|nobaseline
			using = fontsize_large
			text = "CA_PN_HEADER"
			tooltip = "CA_PN_HEADER_TT"
		}

		### Mapa
		widget = {
			name = "ca_pn_map"
			position = { 8 40 }
			size = { 315 420 }

			icon = {
				position = { 0 0 }
				size = { 315 420 }
				texture = "gfx/interface/ca_pacificacion/ca_pn_map_base.dds"
				tooltip = "CA_PN_MAP_TT"
			}

			icon = {
				position = { 0 0 }
				size = { 315 420 }
				texture = "gfx/interface/ca_pacificacion/ca_pn_zone_low.dds"
				datacontext = "[GetScriptedGui('ca_pn_zone_low')]"
				visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			icon = {
				position = { 0 0 }
				size = { 315 420 }
				texture = "gfx/interface/ca_pacificacion/ca_pn_zone_mid.dds"
				datacontext = "[GetScriptedGui('ca_pn_zone_mid')]"
				visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			icon = {
				position = { 0 0 }
				size = { 315 420 }
				texture = "gfx/interface/ca_pacificacion/ca_pn_zone_high.dds"
				datacontext = "[GetScriptedGui('ca_pn_zone_high')]"
				visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}

			icon = {
				position = { 50 30 }
				size = { 24 24 }
				texture = "gfx/interface/ca_pacificacion/ca_pn_marker_politics.dds"
				datacontext = "[GetScriptedGui('ca_pn_beat_1')]"
				visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				tooltip = "CA_PN_BEAT_1_TT"
			}
			icon = {
				position = { 124 186 }
				size = { 24 24 }
				texture = "gfx/interface/ca_pacificacion/ca_pn_marker_politics.dds"
				datacontext = "[GetScriptedGui('ca_pn_beat_3')]"
				visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				tooltip = "CA_PN_BEAT_3_TT"
			}
			icon = {
