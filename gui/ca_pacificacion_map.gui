				datacontext = "[GetScriptedGui('ca_pn_beat_4')]"
				visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				tooltip = "CA_PN_BEAT_4_TT"
			}
			icon = {
				position = { 110 174 }
				size = { 24 24 }
				texture = "gfx/interface/ca_pacificacion/ca_pn_marker_battle.dds"
				datacontext = "[GetScriptedGui('ca_pn_beat_5')]"
				visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				tooltip = "CA_PN_BEAT_5_TT"
			}
			icon = {
				position = { 135 238 }
				size = { 24 24 }
				texture = "gfx/interface/ca_pacificacion/ca_pn_marker_battle.dds"
				datacontext = "[GetScriptedGui('ca_pn_beat_6')]"
				visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				tooltip = "CA_PN_BEAT_6_TT"
			}
			icon = {
				position = { 87 66 }
				size = { 24 24 }
				texture = "gfx/interface/ca_pacificacion/ca_pn_marker_battle.dds"
				datacontext = "[GetScriptedGui('ca_pn_beat_7')]"
				visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				tooltip = "CA_PN_BEAT_7_TT"
			}
		}

		### Etapas
		flowcontainer = {
			position = { 334 40 }
			direction = vertical
			spacing = 2

			textbox = {
				size = { 186 22 }
				align = left|nobaseline
