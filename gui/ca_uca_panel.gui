# ============================================================================
# CAFM - Rediseño del diario de la UCA, entrega 2 (10 nov 2026)
# gui/ca_uca_panel.gui
#  - ca_uca_header_widget (custom_widget_container_je_icon): aspecto de la ruta
#    (color, emblema, titulo, lema), retrato del gobernante y las 3 mini barras de
#    poder (federalista, centralista, separatista; 10 segmentos de 10 puntos).
#  - ca_uca_tabs_widget (custom_widget_container_2): pestanas Gobierno / Estados /
#    Crisis. Cada boton del diario solo sale en su pestana (ca_uca_button_tab).
# Todo se lee de la UCA con JournalEntry.GetCountry.
# ============================================================================

types ca_uca_panel_types {
	type ca_uca_header_type = widget {
		size = { 520 240 }

		background = {
			using = entry_bg_simple
		}

		# --- Aspecto de la ruta federal ---
		widget = {
			size = { 520 240 }
			datacontext = "[GetScriptedGui('ca_uca_route_federal_sgui')]"
			visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			background = {
				texture = "gfx/interface/backgrounds/white.dds"
				color = { 0.20 0.40 0.80 1 }
				alpha = 0.28
			}
			icon = {
				position = { 205 10 }
				size = { 54 54 }
				texture = "gfx/interface/icons/ideology_icons/cafm_ideology_federalist_leader.dds"
			}
			textbox = {
				position = { 266 10 }
				size = { 245 30 }
				align = left|nobaseline
				using = fontsize_large
				default_format = "#title"
				text = "CA_UCA_HDR_TITLE_FEDERAL"
			}
			textbox = {
				position = { 266 40 }
				size = { 245 22 }
				align = left|nobaseline
				using = fontsize_small
				text = "CA_UCA_HDR_MOTTO_FEDERAL"
			}
			textbox = {
				position = { 205 72 }
				size = { 305 70 }
				multiline = yes
				align = left|nobaseline
				using = fontsize_small
				text = "CA_UCA_HDR_DESC_FEDERAL"
			}
		}

		# --- Aspecto de la ruta centralist ---
		widget = {
			size = { 520 240 }
			datacontext = "[GetScriptedGui('ca_uca_route_centralist_sgui')]"
			visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			background = {
				texture = "gfx/interface/backgrounds/white.dds"
				color = { 0.55 0.10 0.08 1 }
				alpha = 0.28
			}
			icon = {
				position = { 205 10 }
				size = { 54 54 }
				texture = "gfx/interface/icons/ideology_icons/cafm_ideology_centralist_leader.dds"
			}
			textbox = {
				position = { 266 10 }
				size = { 245 30 }
				align = left|nobaseline
				using = fontsize_large
				default_format = "#title"
				text = "CA_UCA_HDR_TITLE_CENTRALIST"
			}
			textbox = {
				position = { 266 40 }
				size = { 245 22 }
				align = left|nobaseline
				using = fontsize_small
				text = "CA_UCA_HDR_MOTTO_CENTRALIST"
			}
			textbox = {
				position = { 205 72 }
				size = { 305 70 }
				multiline = yes
				align = left|nobaseline
				using = fontsize_small
				text = "CA_UCA_HDR_DESC_CENTRALIST"
			}
		}

		# --- Retrato del gobernante ---
		widget = {
			position = { 8 8 }
			size = { 190 224 }

			background = {
				using = blurry_dark_background
				alpha = 0.9
			}

			character_portrait_large_torso = {
				visible = "[Not(Character.IsHistorical)]"
				parentanchor = center
				datacontext = "[JournalEntry.GetCountry.GetRuler]"
				blockoverride "show_hat" {}
				blockoverride "highlight" {}
				blockoverride "portrait_size" {
					size = { 85% 85% }
				}
			}
			character_portrait_large_torso_historical_info_link = {
				visible = "[And( Character.IsHistorical, Not(StringIsEmpty(Character.GetHistoricalUrl)) )]"
				parentanchor = center
				datacontext = "[JournalEntry.GetCountry.GetRuler]"
				blockoverride "show_hat" {}
				blockoverride "highlight" {}
				blockoverride "portrait_size" {
					size = { 85% 85% }
				}
			}
			character_portrait_large_torso_historical_no_info_link = {
				visible = "[And( Character.IsHistorical, StringIsEmpty(Character.GetHistoricalUrl) )]"
				parentanchor = center
				datacontext = "[JournalEntry.GetCountry.GetRuler]"
				blockoverride "show_hat" {}
				blockoverride "highlight" {}
				blockoverride "portrait_size" {
					size = { 85% 85% }
				}
			}
		}

