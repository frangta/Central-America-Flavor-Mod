# ============================================================================
# CAFM P1 punto 1 - Widget de je_ca_state_role_in_federation (gui/ca_subject_role_widgets.gui)
# Va en custom_widget_container_1 (el mismo del minimapa), sin parentanchor, para que el
# diario le reserve su alto. Orden: la barra del diario (ca_federal_spectrum_bar) arriba,
# luego este recuadro con el estado y sus facciones, y abajo los 4 botones en rejilla 2x2.
# Los 4 scripted_button se quitaron del diario para que no se pinten aparte.
# ============================================================================

types ca_subject_role_types {
	type ca_subject_role_widget = widget {
		name = "ca_subject_role_widget"
		size = { 530 172 }

		background = {
			using = entry_bg_simple
		}

		# --- Recuadro del estado ---
		widget = {
			position = { 8 6 }
			size = { 514 92 }

			background = {
				using = entry_bg_simple
			}

			textbox = {
				position = { 8 4 }
				size = { 498 84 }
				multiline = yes
				align = left|nobaseline
				using = fontsize_small
				text = "CA_ROLE_BOX"
			}
		}

		# --- Botones (2 x 2) ---
		widget = {
			position = { 0 104 }
			size = { 530 64 }

			button_standard = {
				position = { 8 0 }
				size = { 255 28 }
				text = "ca_button_support_federation"
				datacontext = "[GetScriptedGui('ca_role_support_federation')]"
				visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			button_standard = {
				position = { 267 0 }
				size = { 255 28 }
				text = "ca_button_support_confederation"
				datacontext = "[GetScriptedGui('ca_role_support_confederation')]"
				visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			button_standard = {
				position = { 8 32 }
				size = { 255 28 }
				text = "ca_button_sabotage_federation"
				datacontext = "[GetScriptedGui('ca_role_sabotage_federation')]"
				visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			button_standard = {
				position = { 267 32 }
				size = { 255 28 }
				text = "ca_button_support_centralistas"
				datacontext = "[GetScriptedGui('ca_role_support_centralists')]"
				visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}
	}
}

# El diario busca un widget con este nombre a nivel superior del archivo (F30).
ca_subject_role_widget = {
	name = "ca_subject_role_widget"
}
