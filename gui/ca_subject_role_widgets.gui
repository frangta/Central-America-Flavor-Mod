# COPY-PASTED FOR NOW
@panel_width_minus_10 = 530			# used to be 450
@panel_width_minus_30 = 510
@panel_width = 540  				# used to be 460
@panel_width_half = 270				# used to be 230
@panel_width_plus_10 = 550  		# used to be 470
@panel_width_plus_14 = 554			# used to be 474
@panel_width_plus_14_half = 277		# used to be 237
@panel_width_plus_20 = 560			# used to be 480
@panel_width_plus_30 = 570			# used to be 490
@panel_width_plus_70 = 610			# used to be 530

# game/gui/ca_subject_role_widgets.gui

types ca_subject_role_types {

    # Componente reutilizable para cada nivel del triángulo
    type ca_triangle_pip = widget {
        size = { 18 18 }

        # Estado Inactivo / Base (gris transparente)
        icon = {
            size = { 100% 100% }
            texture = "gfx/interface/backgrounds/round_button_bg.dds" # CAFM fix: radio_button_empty.dds no existe
            alpha = 0.35
        }

        # Estado Activo (iluminado si la condición se cumple)
        icon = {
            block "active_condition" {
                visible = no
            }
            size = { 100% 100% }
            texture = "gfx/interface/icons/generic_icons/green_checkmark.dds" # CAFM fix: radio_button_filled.dds no existe
        }
    }

    # Widget inyectado en custom_widget_container_2
    type ca_subject_role_widget = widget {
        name = "ca_subject_role_widget"
        size = { 340 165 }          # CAFM fix: antes 300, se salia por debajo de los botones
        parentanchor = top|hcenter  # CAFM fix: antes center, empujaba todo hacia abajo

        # Fondo del diagrama estilo Victoria 3
        background = {
            using = entry_bg_simple
        }

        icon = {
            size = { 100% 100% }
            using = simple_frame
        }

        # Título superior del gráfico
        textbox = {
            position = { 0 6 }
            parentanchor = top|hcenter
            autoresize = yes
            align = nobaseline
            using = fontsize_small
            text = "CA_FACTION_ALIGNMENT_TITLE"
            default_format = "#title"
        }

        # ====================================================
        # VÉRTICE SUPERIOR: CENTRALISTAS
        # ====================================================
        container = {
            position = { 0 26 }
            parentanchor = top|hcenter

            flowcontainer = {
                direction = vertical
                spacing = 4
                parentanchor = hcenter

                textbox = {
                     text = "CA_FACTION_CENTRALISTAS" # Antes decía "CENTRALISTAS"
                     align = hcenter|nobaseline
                     autoresize = yes
                     using = fontsize_small
                     parentanchor = hcenter
                     default_format = "#header"
                 }

                # 3 Niveles hacia el vértice superior
                flowcontainer = {
                    direction = horizontal
                    spacing = 8
                    parentanchor = hcenter

                    ca_triangle_pip = {
                        blockoverride "active_condition" {
                            datacontext = "[GetScriptedGui('ca_sgui_centralist_lvl_1')]"
                            visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                        }
                        tooltip = "CA_SGUI_CENTRALIST_1_TT"
                    }
                    ca_triangle_pip = {
                        blockoverride "active_condition" {
                            datacontext = "[GetScriptedGui('ca_sgui_centralist_lvl_2')]"
                            visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                        }
                        tooltip = "CA_SGUI_CENTRALIST_2_TT"
                    }
                    ca_triangle_pip = {
                        blockoverride "active_condition" {
                            datacontext = "[GetScriptedGui('ca_sgui_centralist_lvl_3')]"
                            visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                        }
                        tooltip = "CA_SGUI_CENTRALIST_3_TT"
                    }
                }
            }
        }

        # ====================================================
        # NÚCLEO CENTRAL / RETÍCULA
        # ====================================================
        icon = {
            size = { 60 60 }
            parentanchor = top|hcenter
            position = { 0 72 }
            texture = "gfx/interface/icons/generic_icons/turns_into.dds"
            alpha = 0.45
        }

        # ====================================================
        # VÉRTICE INFERIOR IZQUIERDO: FEDERALISTAS
        # ====================================================
        container = {
            position = { 15 -10 }
            parentanchor = bottom|left

            flowcontainer = {
                direction = vertical
                spacing = 4

                textbox = {
                    text = "CA_FACTION_FEDERALISTAS"
                    align = left|nobaseline
                    autoresize = yes
                    using = fontsize_small
                    default_format = "#header"
                }

                # 3 Niveles hacia el vértice inferior izquierdo
                flowcontainer = {
                    direction = horizontal
                    spacing = 8

                    ca_triangle_pip = {
                        blockoverride "active_condition" {
                            datacontext = "[GetScriptedGui('ca_sgui_federalist_lvl_1')]"
                            visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                        }
                        tooltip = "CA_SGUI_FEDERALIST_1_TT"
                    }
                    ca_triangle_pip = {
                        blockoverride "active_condition" {
                            datacontext = "[GetScriptedGui('ca_sgui_federalist_lvl_2')]"
                            visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                        }
                        tooltip = "CA_SGUI_FEDERALIST_2_TT"
                    }
                    ca_triangle_pip = {
                        blockoverride "active_condition" {
                            datacontext = "[GetScriptedGui('ca_sgui_federalist_lvl_3')]"
                            visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                        }
                        tooltip = "CA_SGUI_FEDERALIST_3_TT"
                    }
                }
            }
        }

        # ====================================================
        # VÉRTICE INFERIOR DERECHO: SEPARATISTAS
        # ====================================================
        container = {
            position = { -15 -10 }
            parentanchor = bottom|right

            flowcontainer = {
                direction = vertical
                spacing = 4

                textbox = {
                    text = "CA_FACTION_SEPARATISTAS"
                    align = right|nobaseline
                    autoresize = yes
                    using = fontsize_small
                    parentanchor = right
                    default_format = "#header"
                }

                # 3 Niveles hacia el vértice inferior derecho
                flowcontainer = {
                    direction = horizontal
                    spacing = 8
                    parentanchor = right

                    ca_triangle_pip = {
                        blockoverride "active_condition" {
                            datacontext = "[GetScriptedGui('ca_sgui_separatist_lvl_1')]"
                            visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                        }
                        tooltip = "CA_SGUI_SEPARATIST_1_TT"
                    }
                    ca_triangle_pip = {
                        blockoverride "active_condition" {
                            datacontext = "[GetScriptedGui('ca_sgui_separatist_lvl_2')]"
                            visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                        }
                        tooltip = "CA_SGUI_SEPARATIST_2_TT"
                    }
                    ca_triangle_pip = {
                        blockoverride "active_condition" {
                            datacontext = "[GetScriptedGui('ca_sgui_separatist_lvl_3')]"
                            visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                        }
                        tooltip = "CA_SGUI_SEPARATIST_3_TT"
                    }
                }
            }
        }
    }
}

# ====================================================================
# CAFM fix: INSTANCIA RAIZ del widget.
# El diario je_ca_state_role_in_federation pide un widget llamado
# "ca_subject_role_widget". Solo existia como TIPO (dentro de types {}),
# asi que el juego no lo encontraba ("Could not find widget") y
# crasheaba al abrir el diario. Esta linea crea el widget real.
# ====================================================================
ca_subject_role_widget = {}

