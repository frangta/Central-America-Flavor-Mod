				}
				button_standard = {
					position = { 8 164 }
					size = { 190 24 }
					text = "CA_MM_ACTION_COOPT"
					datacontext = "[GetScriptedGui('ca_mm_cip_coopt')]"
					visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}
			widget = {
				size = { 206 239 }
				datacontext = "[GetScriptedGui('ca_mm_panel_boc')]"
				visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				background = { using = entry_bg_simple }

				textbox = {
					position = { 0 6 }
					size = { 206 24 }
					align = hcenter|nobaseline
					using = fontsize_small
					default_format = "#title"
					text = "CA_MM_BOC_NAME"
				}
				textbox = {
					position = { 8 34 }
					size = { 190 70 }
					multiline = yes
					using = fontsize_small
					text = "CA_MM_BOC_INFO"
				}
			}
		}
	}
}

