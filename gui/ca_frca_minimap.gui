# ============================================================================
# CAFM - F9/F26 - Minimapa de lealtad en el diario de la Federacion
# (gui/ca_frca_minimap.gui). Cada estado es un boton (pin). El color de cada estado
# sigue su lealtad: Leal verde, Vacilante amarillo, Rebelde naranja, Separado gris.
# Al pulsar un estado se abre su panel con la lealtad y los botones de la ruta.
# Texturas en gfx/interface/ca_minimap/ (generadas a partir del mapa de provincias).
# ============================================================================

types ca_frca_minimap_types {
	type ca_frca_minimap_type = widget {
		name = "ca_frca_minimap_widget"
		size = { 530 262 }
		# F28: sin parentanchor; el contenedor del diario toma el tamano del widget (530 x 262)

		background = {
			using = entry_bg_simple
		}

		# --- Mapa (F26: estilo de mapa antiguo, 12 zonas, texturas a 2x) ---
		widget = {
			name = "ca_mm_map"
			position = { 8 12 }
			size = { 300 239 }

			icon = {
				position = { 0 0 }
				size = { 300 239 }
				texture = "gfx/interface/ca_minimap/ca_minimap_base.dds"
			}
			icon = {
				position = { 18 55 }
				size = { 50 38 }
				texture = "gfx/interface/ca_minimap/ca_minimap_cip_loyal.dds"
				datacontext = "[GetScriptedGui('ca_mm_cip_loyal')]"
