# ============================================================================
# CAFM - F9/F26/P4 - Minimapa de lealtad en el diario de la Federacion
# (gui/ca_frca_minimap.gui). Cada estado es un boton (pin). El color de cada estado
# sigue su lealtad: Leal verde, Vacilante amarillo, Rebelde naranja, Separado gris.
# Al pulsar un estado se abre su panel con la lealtad y los botones de la ruta.
# Texturas en gfx/interface/ca_minimap/ (generadas a partir del mapa de provincias).
# ============================================================================

types ca_frca_minimap_types {
	type ca_frca_minimap_type = widget {
		name = "ca_frca_minimap_widget"
		size = { 530 332 }
		# F28: sin parentanchor; el contenedor del diario toma el tamano del widget
		# P7: 530 x 332 (contador de cohesion arriba, mapa al centro, ventana del estado encima)

		background = {
			using = entry_bg_simple
		}

		# --- P7: contador de Cohesion federal (solo ruta federal) ---
		widget = {
			name = "ca_mm_cohesion"
			position = { 10 8 }
			size = { 510 24 }
			datacontext = "[GetScriptedGui('ca_mm_cohesion_on')]"
			visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
